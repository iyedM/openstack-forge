{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/openstack-forge-cluster.schema.json",
  "title": "OpenStack Forge cluster configuration",
  "description": "Structure of an OpenStack Forge cluster definition. Rules that JSON Schema cannot express (supported release pairs, role counts, address arithmetic) are enforced by openstack_forge.config.semantic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "networks", "nodes"],
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ubuntu_version", "openstack_release", "topology"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ubuntu_version": {
          "type": "string",
          "description": "an Ubuntu release number such as \"24.04\"",
          "pattern": "^[0-9]{2}\\.[0-9]{2}$"
        },
        "openstack_release": {
          "type": "string",
          "description": "an OpenStack release number in YYYY.N form such as \"2025.1\"",
          "pattern": "^[0-9]{4}\\.[12]$"
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "ntp_servers": {
          "type": "array",
          "description": "upstream NTP servers for the controller; when absent, the distribution's default pool is kept",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ntp_server" }
        }
      }
    },
    "networks": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subnet", "gateway", "interface", "floating_ip_range"],
          "properties": {
            "subnet": { "$ref": "#/$defs/ipv4_subnet" },
            "gateway": { "$ref": "#/$defs/ipv4_address" },
            "dns": { "$ref": "#/$defs/dns_servers" },
            "interface": { "$ref": "#/$defs/interface_name" },
            "floating_ip_range": { "$ref": "#/$defs/ipv4_range" },
            "dhcp_range": { "$ref": "#/$defs/ipv4_range" }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subnet", "gateway", "interface"],
        "properties": {
          "subnet": { "$ref": "#/$defs/ipv4_subnet" },
          "gateway": { "$ref": "#/$defs/ipv4_address" },
          "dns": { "$ref": "#/$defs/dns_servers" },
          "interface": { "$ref": "#/$defs/interface_name" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "ntp_server": {
      "type": "string",
      "description": "a hostname, a fully qualified domain name or an IPv4 address, such as \"ntp.example.internal\"",
      "pattern": "^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
    },
    "ipv4_address": {
      "type": "string",
      "format": "ipv4"
    },
    "ipv4_subnet": {
      "type": "string",
      "description": "an IPv4 network in CIDR notation such as \"10.0.0.0/24\"",
      "pattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}/(?:[0-9]|[1-2][0-9]|3[0-2])$"
    },
    "ipv4_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/ipv4_address" },
        "end": { "$ref": "#/$defs/ipv4_address" }
      }
    },
    "dns_servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/ipv4_address" }
    },
    "interface_name": {
      "type": "string",
      "minLength": 1
    },
    "device_path": {
      "type": "string",
      "description": "an absolute block device path under /dev such as \"/dev/sdb\" or \"/dev/disk/by-id/...\"",
      "pattern": "^(?!.*/\\.{1,2}(?:/|$))/dev/(?:[A-Za-z0-9._:+@-]+/)*[A-Za-z0-9._:+@-]+$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "hostname",
        "fqdn",
        "management_ip",
        "vcpus",
        "ram_gb",
        "interfaces"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["controller", "compute", "block", "object"]
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "description": "a single DNS label (letters, digits and inner hyphens, at most 63 characters)",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
        },
        "fqdn": {
          "type": "string",
          "minLength": 1,
          "description": "a fully qualified domain name with at least two DNS labels, such as \"node-01.example.internal\"",
          "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
        },
        "management_ip": { "$ref": "#/$defs/ipv4_address" },
        "vcpus": {
          "type": "integer",
          "minimum": 1
        },
        "ram_gb": {
          "type": "integer",
          "minimum": 1
        },
        "disk": { "$ref": "#/$defs/device_path" },
        "disks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/device_path" }
        },
        "interfaces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/interface_name" }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["role"], "properties": { "role": { "const": "block" } } },
          "then": { "required": ["disk"] },
          "else": { "not": { "required": ["disk"] } }
        },
        {
          "if": { "required": ["role"], "properties": { "role": { "const": "object" } } },
          "then": { "required": ["disks"] },
          "else": { "not": { "required": ["disks"] } }
        }
      ]
    }
  }
}
