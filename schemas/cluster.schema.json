{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/openstack-forge-cluster.schema.json",
  "title": "OpenStack Forge cluster configuration",
  "description": "Initial draft schema for validating the cluster topology. This is intentionally minimal and will evolve with the project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "networks", "nodes"],
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ubuntu_version", "openstack_release", "topology"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ubuntu_version": {
          "type": "string",
          "description": "an Ubuntu release number such as \"22.04\" or \"22.04.4\"",
          "pattern": "^(?:[0-9]+\\.[0-9]+|[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "openstack_release": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subnet", "gateway", "interface"],
        "properties": {
          "subnet": {
            "type": "string",
            "description": "an IPv4 network in CIDR notation such as \"10.0.0.0/24\"",
            "pattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}/(?:[0-9]|[1-2][0-9]|3[0-2])$"
          },
          "gateway": {
            "type": "string",
            "format": "ipv4"
          },
          "dns": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "ipv4"
            }
          },
          "interface": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "hostname", "fqdn", "management_ip", "interfaces"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["controller", "compute", "storage"]
          },
          "hostname": {
            "type": "string",
            "minLength": 1,
            "description": "a single DNS label (letters, digits and inner hyphens, at most 63 characters)",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          },
          "fqdn": {
            "type": "string",
            "minLength": 1,
            "description": "a fully qualified domain name with at least two DNS labels, such as \"node-01.example.internal\"",
            "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          },
          "management_ip": {
            "type": "string",
            "format": "ipv4"
          },
          "interfaces": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
